SECRET_KEY=generate_your_secret_key_here
BASE_UPLOAD_FOLDER=/app/uploads

# Passwörter für den MariaDB Docker-Container
DB_ROOT_PASSWORD=your_secure_root_password
DB_PASSWORD=your_secure_db_password

# Die URL für Flask
SQLALCHEMY_DATABASE_URI=mysql+pymysql://oortcloud_user:your_secure_db_password@db:3306/oortcloud_db